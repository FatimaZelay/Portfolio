---
const response = await fetch(
  "https://api.github.com/users/FatimaZelay/repos?sort=updated&per_page=10",
);
const repos: any[] = await response.json();
---

<section class="repo-section">
  <h2>Check what i've been working on</h2>

  <div class="repo-wrapper">
    <ul class="repo-list">
      {
        repos.map((repo) => (
          <li class="repo-card">
            <a href={repo.html_url} target="_blank">
              <span class="repo-name">{repo.name}</span>
              <span class="repo-desc">
                {repo.description || "One of my works :)"}
              </span>
              <span class="repo-lang">{repo.language || "—"}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="fade-overlay"></div>
  </div>
</section>

<style>
  .repo-section {
    padding: 4rem 2rem;
    text-align: center;
  }
  h2 {
    font-family: "Poppins", sans-serif;
    font-size: 2rem;
    font-weight: 900;
    color: #1a1a1a;
    margin-bottom: 2rem;
  }

  .repo-name {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
  }
  .repo-wrapper {
    position: relative;
    max-height: 480px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .repo-wrapper::-webkit-scrollbar {
    display: none;
  }

  .fade-overlay {
    position: sticky;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, #ffffff);
    pointer-events: none;
  }

  .repo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    padding-bottom: 80px;
  }

  .repo-card {
    border: 1.5px solid #e1dbce;
    border-radius: 16px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .repo-card:hover {
    border-color: #e1dbce;
    border-width: 3px;
  }

  .repo-card a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
  }

  .repo-name {
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .repo-desc {
    font-size: 13px;
    color: #777;
    line-height: 1.5;
  }

  .repo-lang {
    font-size: 12px;
    color: #e1dbce;
    font-weight: 500;
  }
</style>

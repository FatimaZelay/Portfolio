---
import home from "../../assets/home.svg";
import about from "../../assets/about.svg";
---

<section class="homepage">
  <h1 class="title">
    <span class="word-lets">Let's</span>
    <span class="word-work"> work </span>
    <span class="word-together">together.</span>
  </h1>
  <h2>Creative & Webdeveloper</h2>

  <div class="grid">
    <img src="/bag.png" alt="Shopping bag with logo" />
    <img src="/branding.png" alt="Branding" />
    <img src="/webdesign.png" alt="Webdesign" />
  </div>

  <button
    class="scroll-indicator"
    onclick="window.scrollTo({ top: window.innerHeight, behavior: 'smooth' })"
  >
    <img src={home.src} alt="home" />
    <span>↓</span>
  </button>
</section>

<script>
  import { gsap } from "gsap";

  const tl = gsap.timeline();

  tl.from(".word-lets", {
    duration: 1,
    y: 60,
    opacity: 0,
    ease: "expo.out",
  })
    .from(
      ".word-work",
      {
        duration: 1.4,
        scale: 0,
        opacity: 0,
        ease: "expo.out(1, 0.5)",
      },
      "-=0.3",
    )
    .from(
      ".word-together",
      {
        duration: 1,
        y: 60,
        opacity: 0,
        ease: "expo.out",
      },
      "-=0.8",
    )
    .from(
      "h2",
      {
        duration: 1,
        y: 30,
        opacity: 0,
        ease: "expo.out",
      },
      "-=0.3",
    )
    .from(
      ".grid img",
      {
        duration: 1.2,
        opacity: 0,
        ease: "expo.out",
        stagger: 0.15,
      },
      "-=0.5",
    );
</script>

<style>
  .homepage {
    text-align: center;
    padding: 6rem 2rem 2rem;
    position: relative;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
  }

  h1 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .word-work {
    color: #e1dbce;
    display: inline-block;
  }

  .word-lets,
  .word-together {
    display: inline-block;
  }

  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .grid img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 1rem;
    opacity: 0.9;
    transition: transform 0.3s ease;
  }

  .scroll-indicator {
    position: fixed;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
    background: none;
    border: none;
    cursor: pointer;
  }

  .scroll-indicator img {
    width: 50px;
  }

  .scroll-indicator span {
    font-size: 1.5rem;
    margin-top: 0.3rem;
  }
</style>
